# Template only. Set these environment variables before starting Java/Node.
# Spring and this Node gateway do not automatically load this file.
DB_URL=jdbc:postgresql://localhost:5432/cpfriendfinder
DB_USERNAME=postgres
DB_PASSWORD=
SERVER_PORT=8080
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BACKEND_URL=http://127.0.0.1:8080
PORT=3000
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
CLOUDFLARE_TURN_TTL=86400

# Public image URL may differ from internal S3 endpoint. Compose serves images via /media.
AWS_PUBLIC_URL_S3=
AWS_BUCKET=storage
